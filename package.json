{
  "name": "ddd-favorites",
  "version": "1.0.0",
  "description": "DDD Milano schedule with favorites feature",
  "type": "module",
  "scripts": {
    "fetch": "bun scripts/fetch-schedule.js",
    "dev": "bun run fetch && vite",
    "build": "bun run fetch && vite build",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "prepare": "husky",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "husky": "^9.1.7",
    "node-html-parser": "^6.1.13",
    "sass": "^1.99.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@preact/signals": "^2.9.0",
    "preact": "^10.29.1"
  }
}
